# Données brutes : jamais versionnées (RG-01), récupérées par scripts/download.py
data/raw/*
!data/raw/.gitkeep
!data/raw/LISEZMOI.md

# Données dérivées, versions locales de l'entreprise et caches (RG-13, RG-17)
data/processed/*
!data/processed/.gitkeep
data/versions/*
!data/versions/.gitkeep
data/versions.yaml

# Réglages locaux de l'entreprise et scénarios enregistrés
config/parametres_modifies.yaml
config/entreprise.local.yaml
scenarios/*
!scenarios/.gitkeep
!scenarios/demo/
data/cache/

# Projets Brightway locaux
brightway/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Interface (frontend/dist/ reste versionné : l'interface est livrée compilée)
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
frontend/coverage/
frontend/*.tsbuildinfo

# Environnement local et système
.claude/settings.local.json
.env
.env.*
.venv/
.DS_Store
.idea/
.vscode/
*.log
data/osrm/
config/sites.local.yaml
config/decision.local.yaml

# Démonstration : pointeur local du scénario chargé (scenarios/demo/ reste suivi par Git)
config/demo.local.yaml
