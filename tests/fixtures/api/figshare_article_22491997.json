e": false, "url_name": "_", "orcid_id": ""}, {"id": 15058710, "full_name": "Thu Ha Nguyen", "first_name": "Thu Ha", "last_name": "Nguyen", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 569445, "full_name": "Giulia Conchedda", "first_name": "Giulia", "last_name": "Conchedda", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15058716, "full_name": "Leon Casse", "first_name": "Leon", "last_name": "Casse", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15058719, "full_name": "Francesco N. Tubiello", "first_name": "Francesco N.", "last_name": "Tubiello", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 3341375, "full_name": "Federico Maggi", "first_name": "Federico", "last_name": "Maggi", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/CROPGRIDS/22491997", "download_disabled": false, "description": "<p dir=\"ltr\">CROPGRIDS is a comprehensive global, geo-referenced dataset providing area information for 173 crops circa the year 2020, at a resolution of 0.05\u02da (~5.6 km at the equator). It represents a major update of the Monfreda et al. (2008) dataset (hereafter MRF), the most widely used geospatial dataset previously available, covering 175 crops with reference year 2000 at 10 km spatial resolution. CROPGRIDS builds on information originally provided in MRF and expands it using 28 selected published gridded datasets, providing more recent crop information at regional, national, and global levels, largely covering the period 2015 \u2013 2020. By combining the gridded information and the 2020 national-level statistics from FAOSTAT, CROPGRIDS reports the 2020 updated maps of harvested and crop (physical) area for 173 crops. The new CROPGRIDS data represent a useful input into modelling studies and sustainability analyses including in support of the 2030 Sustainable Development Agenda.</p><p><br></p><p dir=\"ltr\">For more information, please refer to:</p><p dir=\"ltr\">Tang F. H. M., Nguyen T. H., Conchedda G., Casse L., Tubiello F., and Maggi F. (2023). CROPGRIDS, a global geo-referenced dataset of 173 crops, <u>Scientific Data</u>.</p>", "funding": null, "funding_list": [], "version": 9, "status": "public", "size": 948409515, "created_date": "2024-04-24T03:58:04Z", "modified_date": "2024-04-24T03:58:04Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Crop type maps", "Harvested area", "Crop area", "Global"], "keywords": ["Crop type maps", "Harvested area", "Crop area", "Global"], "categories": [{"id": 23881, "title": "Sustainable agricultural development", "parent_id": 23851, "path": "/23812/23851/23881", "source_id": "300210", "taxonomy_id": 100}, {"id": 23857, "title": "Agricultural land management", "parent_id": 23851, "path": "/23812/23851/23857", "source_id": "300202", "taxonomy_id": 100}, {"id": 23860, "title": "Agricultural land planning", "parent_id": 23851, "path": "/23812/23851/23860", "source_id": "300203", "taxonomy_id": 100}, {"id": 23869, "title": "Agricultural spatial analysis and modelling", "parent_id": 23851, "path": "/23812/23851/23869", "source_id": "300206", "taxonomy_id": 100}], "references": [], "has_linked_file": false, "citation": "Tang, Fiona  H. M.; Nguyen, Thu Ha; Conchedda, Giulia; Casse, Leon; Tubiello, Francesco N.; Maggi, Federico (2023). CROPGRIDS. figshare. Dataset. https://doi.org/10.6084/m9.figshare.22491997.v9", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 22491997, "title": "CROPGRIDS", "doi": "10.6084/m9.figshare.22491997.v9", "handle": "", "url": "https://api.figshare.com/v2/articles/22491997", "published_date": "2024-04-24T03:58:04Z", "thumb": "https://